# Copy to .env and fill in. Never commit .env.

# Gnani Speech API key from https://app.gnani.ai/voice (sent as X-API-Key-ID)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGS=hi-IN,en-IN
GNANI_TTS_MODEL=timbre-v2.5
# 1 = use fixture audio/transcripts instead of calling Gnani (dev/tests)
GNANI_MOCK=0

# Google AI Studio key for the dialog LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Optional free backup LLM (Groq, OpenAI-compatible). Used only if Gemini is rate-limited.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hosted copy only
ACCESS_CODE=
DAILY_GNANI_CAP=300
